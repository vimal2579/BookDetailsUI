import jenkins.model.Jenkins
import com.cloudbees.plugins.credentials.CredentialsScope
import com.cloudbees.plugins.credentials.SystemCredentialsProvider
import com.cloudbees.plugins.credentials.domains.Domain
import com.cloudbees.plugins.credentials.CredentialsStore

// Import the OIDC token credential class (verify these names in your plugin version)
import io.jenkins.plugins.oidc_provider.IdTokenStringCredentials
// Or maybe other class like IdTokenCredentials (or something similar)
import io.jenkins.plugins.oidc_provider.IdTokenStringCredentialsImpl

// Create the OIDC credential
def createOidcTokenCredential(String credentialId, String audience, String issuer, String description) {
    // Scope: GLOBAL
    CredentialsScope scope = CredentialsScope.GLOBAL

    // Construct the credential object. The constructor parameters may vary!
    // Here's a hypothetical constructor:
    def cred = new IdTokenStringCredentialsImpl(
        scope,         // scope
        credentialId,  // id
        audience,      // audience (String)
        issuer,        // issuer (String) — may be optional, can be null or empty
        description    // description
    )

    // Now add to Jenkins credentials store
    def store = SystemCredentialsProvider.getInstance().getStore()
    // Domain: use the global domain (null domain or Domain.global())
    Domain domain = Domain.global()

    // Add
    store.addCredentials(domain, cred)
    println "Created OIDC token credential with id: ${credentialId}"
}

// Example usage
createOidcTokenCredential(
    "my-oidc-token-cred",
    "jenkins-audience",   // audience you want
    "",                    // issuer, empty string uses default (if plugin supports)
    "My OIDC token credential created via init script"
)

// Save just in case
Jenkins.instance.save()

